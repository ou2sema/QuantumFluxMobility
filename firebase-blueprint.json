{
  "entities": {
    "Vehicle": {
      "title": "Vehicle",
      "description": "Fleet vehicle with technical specs, status, and pricing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "brand": { "type": "string", "maxLength": 64 },
        "model": { "type": "string", "maxLength": 64 },
        "plate": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["AVAILABLE", "RENTED", "MAINTENANCE", "RESERVED"] },
        "mileage": { "type": "number" },
        "dailyRate": { "type": "number" },
        "currentFuelLevel": { "type": "number" },
        "fuelType": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "brand", "model", "plate", "category", "status", "dailyRate"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Rental reservation and contract",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "bookingNumber": { "type": "string", "maxLength": 64 },
        "clientId": { "type": "string", "maxLength": 128 },
        "vehicleId": { "type": "string", "maxLength": 128 },
        "startDate": { "type": "string", "maxLength": 64 },
        "endDate": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["CONFIRMED", "IN_PROGRESS", "COMPLETED", "CANCELLED"] },
        "totalAmount": { "type": "number" },
        "depositAmount": { "type": "number" }
      },
      "required": ["id", "bookingNumber", "clientId", "vehicleId", "startDate", "endDate", "status"]
    },
    "Client": {
      "title": "Client",
      "description": "Registered agency customer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "firstName": { "type": "string", "maxLength": 64 },
        "lastName": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "drivingLicenseNumber": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "firstName", "lastName", "email", "phone"]
    },
    "Maintenance": {
      "title": "Maintenance",
      "description": "Vehicle service and repair records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "vehicleId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 64 },
        "cost": { "type": "number" },
        "status": { "type": "string", "enum": ["SCHEDULED", "IN_PROGRESS", "COMPLETED"] }
      },
      "required": ["id", "vehicleId", "type", "cost", "status"]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "Agency staff member profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["ADMIN", "MANAGER", "AGENT", "ACCOUNTANT", "MECHANIC"] }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Agency": {
      "title": "Agency",
      "description": "Agency branch location",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "city": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "city"]
    }
  },
  "firestore": {
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Agency vehicles"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Rental bookings"
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Agency clients"
    },
    "/maintenances/{maintenanceId}": {
      "schema": { "$ref": "#/entities/Maintenance" },
      "description": "Maintenance operations"
    },
    "/appUsers/{userId}": {
      "schema": { "$ref": "#/entities/AppUser" },
      "description": "Staff users"
    },
    "/agencies/{agencyId}": {
      "schema": { "$ref": "#/entities/Agency" },
      "description": "Agencies"
    },
    "/checkIns/{checkInId}": {
      "schema": "CheckIn",
      "description": "Vehicle return inspection reports"
    },
    "/checkOuts/{checkOutId}": {
      "schema": "CheckOut",
      "description": "Vehicle pickup inspection reports"
    }
  }
}
