rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Basic Validation Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role-based helper functions looking up the user profile document in /appUsers/$(request.auth.uid)
    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/appUsers/$(request.auth.uid))
        ? get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data.role
        : (request.auth.token.role != null ? request.auth.token.role : 'CUSTOMER');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        getUserRole() == 'ADMIN'
      );
    }

    function isManager() {
      return isSignedIn() && (
        isAdmin() ||
        getUserRole() == 'MANAGER'
      );
    }

    function isAgent() {
      return isSignedIn() && (
        isManager() ||
        getUserRole() == 'AGENT'
      );
    }

    function isFleetStaff() {
      return isSignedIn() && (
        isManager() ||
        getUserRole() == 'FLEET'
      );
    }

    function isAccountant() {
      return isSignedIn() && (
        isManager() ||
        getUserRole() == 'ACCOUNTANT'
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() || isManager() || isAgent() || isFleetStaff() || isAccountant()
      );
    }

    // Customer Ownership validation
    function isCustomerOwner(clientId) {
      return isSignedIn() && (
        request.auth.uid == clientId ||
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email))
      );
    }

    // --- 0. Health & Connection Test ---
    match /test/{docId} {
      allow read, write: if true;
    }

    // --- 0.1. User Credentials (PIN Hashes, Salts, Lockout States) ---
    match /userCredentials/{credentialId} {
      allow read, write: if isValidId(credentialId);
    }

    // --- 1. App Users (Staff Profiles & Accounts) ---
    match /appUsers/{userId} {
      allow read, write: if isValidId(userId);
    }

    // --- 2. Vehicles Collection ---
    match /vehicles/{vehicleId} {
      allow read, write: if isValidId(vehicleId);
    }

    // --- 3. Clients Collection ---
    match /clients/{clientId} {
      allow read, write: if isValidId(clientId);
    }

    // --- 4. Bookings Collection ---
    match /bookings/{bookingId} {
      allow read, write: if isValidId(bookingId);
    }

    // --- 5. Payments Collection ---
    match /payments/{paymentId} {
      allow read, write: if isValidId(paymentId);
    }

    // --- 6. Invoices Collection ---
    match /invoices/{invoiceId} {
      allow read, write: if isValidId(invoiceId);
    }

    // --- 7. Maintenances Collection ---
    match /maintenances/{maintenanceId} {
      allow read, write: if isValidId(maintenanceId);
    }

    // --- 8. Agencies Collection ---
    match /agencies/{agencyId} {
      allow read, write: if isValidId(agencyId);
    }

    // --- 9. Check-ins & Check-outs ---
    match /checkIns/{checkInId} {
      allow read, write: if isValidId(checkInId);
    }

    match /checkOuts/{checkOutId} {
      allow read, write: if isValidId(checkOutId);
    }

    // --- 10. Damage Records ---
    match /damageRecords/{damageId} {
      allow read, write: if isValidId(damageId);
    }

    // --- 11. Activity & Security Logs ---
    match /activityLogs/{logId} {
      allow read, write: if isValidId(logId);
    }

    // --- 12. Notifications ---
    match /notifications/{notifId} {
      allow read, write: if isValidId(notifId);
    }
  }
}
